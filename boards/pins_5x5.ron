(
    // Pinned: 1x2 blocks slide only sideways, 2x1 blocks slide only up/down,
    // 1x1 blocks roam freely. Only 7 empty cells, so every bar move counts and
    // the two free 1x1 pieces are the keys that let the lanes shuffle.
    width: 5,
    height: 5,
    pinned: true,
    blocks: [
        // color: (r, g, b, a) (linear), top_left: (x, y)
        (color: (0.9, 0.2, 0.3, 1.0), top_left: (0, 0), width: 2, height: 1), // red    (slides vertically)
        (color: (0.2, 0.35, 0.85, 1.0), top_left: (3, 0), width: 2, height: 1), // blue   (slides vertically)
        (color: (0.1, 0.75, 0.7, 1.0), top_left: (0, 1), width: 1, height: 2), // teal   (slides horizontally)
        (color: (0.45, 0.15, 0.85, 1.0), top_left: (4, 1), width: 1, height: 2), // purple (slides horizontally)
        (color: (0.5, 0.8, 0.15, 1.0), top_left: (2, 1), width: 1, height: 1), // lime   (free)
        (color: (0.85, 0.55, 0.1, 1.0), top_left: (1, 2), width: 2, height: 1), // orange (slides vertically)
        (color: (0.2, 0.85, 0.3, 1.0), top_left: (2, 3), width: 1, height: 2), // green  (slides horizontally)
        (color: (0.85, 0.1, 0.6, 1.0), top_left: (0, 4), width: 2, height: 1), // magenta (slides vertically)
        (color: (0.5, 0.1, 0.9, 1.0), top_left: (3, 4), width: 2, height: 1), // violet (slides vertically)
        (color: (0.15, 0.8, 0.5, 1.0), top_left: (4, 3), width: 1, height: 1), // emerald (free)
    ],
)
