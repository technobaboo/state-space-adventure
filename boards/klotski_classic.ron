(
    // The classic Hua Rong Dao layout: free-sliding blocks, two empty cells.
    width: 4,
    height: 5,
    pinned: false,
    blocks: [
        // color: (r, g, b, a) (linear), top_left: (x, y)
        (color: (0.9, 0.2, 0.3, 1.0), top_left: (1, 0), width: 2, height: 2), // the big 2x2 "general"
        (color: (0.45, 0.15, 0.85, 1.0), top_left: (0, 0), width: 1, height: 2), // purple
        (color: (0.2, 0.35, 0.85, 1.0), top_left: (3, 0), width: 1, height: 2), // blue
        (color: (0.1, 0.75, 0.7, 1.0), top_left: (0, 2), width: 1, height: 2), // teal
        (color: (0.5, 0.1, 0.9, 1.0), top_left: (3, 2), width: 1, height: 2), // violet
        (color: (0.85, 0.55, 0.1, 1.0), top_left: (1, 2), width: 2, height: 1), // orange bar
        (color: (0.85, 0.1, 0.6, 1.0), top_left: (1, 3), width: 1, height: 1), // magenta
        (color: (0.5, 0.8, 0.15, 1.0), top_left: (2, 3), width: 1, height: 1), // lime
        (color: (0.9, 0.35, 0.2, 1.0), top_left: (0, 4), width: 1, height: 1), // tomato
        (color: (0.15, 0.8, 0.5, 1.0), top_left: (3, 4), width: 1, height: 1), // emerald
    ],
)
