(
    // A roomier pinned puzzle. Lots of bars crossing each other's lanes,
    // so the single-cell pieces have to act as keys to unjam the traffic.
    width: 6,
    height: 6,
    pinned: true,
    blocks: [
        // color: (r, g, b, a) (linear), top_left: (x, y)
        (color: (0.9, 0.2, 0.3, 1.0), top_left: (1, 0), width: 3, height: 1), // red    (slides vertically)
        (color: (0.45, 0.15, 0.85, 1.0), top_left: (5, 0), width: 1, height: 3), // purple (slides horizontally)
        (color: (0.2, 0.85, 0.3, 1.0), top_left: (0, 1), width: 1, height: 2), // green  (slides horizontally)
        (color: (0.5, 0.8, 0.15, 1.0), top_left: (2, 2), width: 1, height: 1), // lime   (free)
        (color: (0.85, 0.55, 0.1, 1.0), top_left: (3, 3), width: 2, height: 1), // orange (slides vertically)
        (color: (0.1, 0.75, 0.7, 1.0), top_left: (1, 3), width: 1, height: 2), // teal   (slides horizontally)
        (color: (0.85, 0.1, 0.6, 1.0), top_left: (0, 4), width: 1, height: 1), // magenta (free)
        (color: (0.2, 0.35, 0.85, 1.0), top_left: (3, 5), width: 3, height: 1), // blue   (slides vertically)
        (color: (0.15, 0.8, 0.5, 1.0), top_left: (2, 5), width: 1, height: 1), // emerald (free)
    ],
)
