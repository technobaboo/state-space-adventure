(
    // Compact 4x4 free-slide puzzle built around the 2x2 block.
    // 5 empty cells: enough room to maneuver, not enough to be trivial.
    width: 4,
    height: 4,
    pinned: false,
    blocks: [
        // color: (r, g, b, a) (linear), top_left: (x, y)
        (color: (0.9, 0.2, 0.3, 1.0), top_left: (0, 0), width: 2, height: 2), // red 2x2
        (color: (0.45, 0.15, 0.85, 1.0), top_left: (2, 0), width: 1, height: 2), // purple
        (color: (0.1, 0.75, 0.7, 1.0), top_left: (3, 1), width: 1, height: 2), // teal
        (color: (0.85, 0.55, 0.1, 1.0), top_left: (0, 2), width: 2, height: 1), // orange
        (color: (0.5, 0.8, 0.15, 1.0), top_left: (2, 3), width: 1, height: 1), // lime
    ],
)
